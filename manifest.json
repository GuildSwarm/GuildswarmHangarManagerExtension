{
    "manifest_version": 3,
    "name": "Guildswarm - Hangar Manager Extension",
    "description": "Guildswarm Hangar Manager Extension offers you a tool to download all information of your RSI hangar in one file with just one click",
    "default_locale": "es",
    "version": "1.3",
    "icons": {
        "128": "guildswarm_128.png"
    },
    "permissions": [
        "activeTab",
        "scripting",
        "cookies"
    ],
    "host_permissions": [
        "https://robertsspaceindustries.com/*"
    ],
    "background": {
        "service_worker": "background/index.js"
    },
    "web_accessible_resources": [
        {
            "resources": ["assets/*", "assets/fonts/*"],
            "matches": ["https://robertsspaceindustries.com/*"]
        }
    ],
    "content_scripts": [
        {
            "matches": ["https://robertsspaceindustries.com/*/account/pledges*"],
            "js": ["content/contentScript.js"],
            "css": ["content/styles.css"]
        }
    ]
}
