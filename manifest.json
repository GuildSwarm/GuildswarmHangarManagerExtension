{
    "manifest_version": 3,
    "name": "__MSG_extName__",
    "description": "__MSG_extDescription__",
    "default_locale": "en",
    "version": "2.0.0",
    "icons": {
        "16": "guildswarm_16.png",
        "32": "guildswarm_32.png",
        "48": "guildswarm_48.png",
        "128": "guildswarm_128.png"
    },
    "permissions": [
        "activeTab",
        "scripting",
        "cookies",
        "storage",
        "unlimitedStorage"
    ],
    "host_permissions": [
        "https://robertsspaceindustries.com/*",
        "https://sctools.guildswarm.org/*"
    ],
    "background": {
        "service_worker": "background/index.js"
    },
    "web_accessible_resources": [
        {
            "resources": ["assets/*", "assets/fonts/*"],
            "matches": ["https://robertsspaceindustries.com/*"]
        }
    ],
    "content_scripts": [
        {
            "matches": ["https://robertsspaceindustries.com/*/account/pledges*"],
            "js": ["content/contentScript.js", "content/pledgeFocus.js"],
            "css": ["content/styles.css"]
        },
        {
            "matches": ["https://sctools.guildswarm.org/*"],
            "js": ["content/sctoolsBridge.js"],
            "run_at": "document_start"
        }
    ]
}
